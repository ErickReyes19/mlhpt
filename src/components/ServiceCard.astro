---
const { iconSrc, title, description, linkHref, linkText, color } = Astro.props;
---

<div class="p-8">
  <!-- Icon Section -->
  <div class={`rounded-full w-16 h-16 flex justify-center items-center shadow-2xl ${color.bgColor}`}>
    <img src={iconSrc} class="h-8 w-8" alt={title} />
  </div>

  <!-- Title Section -->
  <h2 class={`uppercase mt-6 font-medium mb-3 ${color.textColor}`}>
    {title}
  </h2>

  <!-- Description Section -->
  <p class="font-light text-sm text-gray-500 mb-3">
    {description}
  </p>

  <!-- Link Section -->
  <a class={`flex items-center hover:${color.hoverColor} ${color.textColor}`} href={linkHref}>
    {linkText}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
        clip-rule="evenodd"
      />
    </svg>
  </a>
</div>
